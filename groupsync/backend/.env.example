# Copy to .env and edit. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# SQLite for development. For production use e.g.
# postgresql+psycopg2://user:password@localhost:5432/groupsync
DATABASE_URL=sqlite:///./groupsync.db

# Comma-separated list, or * for all (dev only)
CORS_ORIGINS=*

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

SCHEDULER_ENABLED=true
DEADLINE_CHECK_INTERVAL_MINUTES=60
